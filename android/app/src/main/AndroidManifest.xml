<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 麦克风权限：课堂语音转写，必需 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 网络权限：调用 DeepSeek AI 总结，必需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 访问网络状态：判断网络是否可用（可选但推荐） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 唤醒锁：录音期间保持 CPU 运行，避免锁屏后麦克风采集被系统掐断 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前台服务：录音期间常驻，把进程优先级提到最高，防止锁屏后被系统回收。
         Android 9+ 起前台服务必须声明 FOREGROUND_SERVICE；
         Android 14+（API 34）起还必须按类型声明具体权限，录音用 microphone 类型。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 通知权限：Android 13+（API 33）起常驻通知需要用户授权，否则前台服务通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 说明：旧版这里还有三条蓝牙权限和一个 RecognitionService 的 queries 块，
         它们是已删除的 speech_to_text（系统语音引擎方案）遗留的，
         现在走的是「录音上传硅基流动识别」，不需要蓝牙，已一并移除。 -->

    <!-- allowBackup=false：两个 API Key 存在 SharedPreferences 里，
         开着自动备份会把它们传到云端（Google 账号备份），没必要冒这个险。
         笔记本身在 SQLite 里，丢了可以从设置里重新填 Key，不该靠云备份。 -->
    <application
        android:label="课堂笔记"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 录音前台服务。必须手动注册，否则 startService 时直接崩。
             android:name 不能改（插件按全限定类名查找）。
             foregroundServiceType 用 microphone：录音属于麦克风类型，
             对应 FOREGROUND_SERVICE_MICROPHONE 权限。 -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
